{
  "name": "brew-and-go-backend",
  "version": "2.0.0",
  "description": "Brew & Go Coffee Shop REST API — Full Featured v2",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev":   "nodemon server.js",
    "lint":  "eslint . --ext .js --ignore-path .eslintignore",
    "test":  "jest --coverage --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs":          "^2.4.3",
    "compression":       "^1.7.4",
    "cors":              "^2.8.5",
    "dotenv":            "^16.4.5",
    "express":           "^4.18.3",
    "express-rate-limit":"^7.2.0",
    "helmet":            "^7.1.0",
    "joi":               "^17.12.0",
    "jsonwebtoken":      "^9.0.2",
    "morgan":            "^1.10.0",
    "node-cache":        "^5.1.2",
    "winston":           "^3.13.0"
  },
  "devDependencies": {
    "eslint":    "^8.57.0",
    "jest":      "^29.7.0",
    "nodemon":   "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch":       ["**/tests/**/*.test.js"]
  },
  "engines": { "node": ">=18.0.0" }
}
